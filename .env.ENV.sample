# Credentials and secrets of ONE environment (FEAT-04).
# Copy to .env.dev / .env.stg / .env.prod (ignored by Git) and fill in the
# values of that environment's accounts. compose.yaml loads .env.<DEPLOY_ENV>
# into the container started with that DEPLOY_ENV.
# Docker Compose reads this file: wrap values containing '$' in single quotes
# (otherwise '$...' is expanded as a variable and the value is cut off, even in
# double quotes), e.g. AWSDB_ROOT_PASSWORD='pa$word',
# and values containing ' #' in quotes (otherwise the rest is a comment).

# ---- Cloud credentials -------------------------------------------------------
# AWS
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ID
# Azure (service principal)
ARM_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID
ARM_CLIENT_ID=YOUR_appID
ARM_CLIENT_SECRET=YOUR_password
ARM_TENANT_ID=YOUR_tenant
ARM_ENVIRONMENT=public
# Google Cloud: key file path inside the container (one key per environment)
GOOGLE_CLOUD_KEYFILE_JSON=YOUR_SERVICE_ACCOUNT_CREDENTIAL_PATH
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID

# ---- Application secrets (formerly config/.env) ------------------------------
AWSDB_ROOT_USER="root"
AWSDB_ROOT_PASSWORD="MySecurePassword123!"
GOOGLEDB_ROOT_USER="root"
GOOGLEDB_ROOT_PASSWORD="MySecurePassword123!"
AZUREDB_ROOT_USER="root"
AZUREDB_ROOT_PASSWORD="MySecurePassword123!"
AZURE_APPGW_SSL_CERT_PASSWORD=
GOOGLE_AZURE_VPN_PRESHARED_KEY=
ECS_WORKER_POSTGRES_PASSWORD=

# node & terraform
NODE_VERSION=24.18.1
TERRAFORM_VERSION=1.16.1
OPENTOFU_VERSION=1.12.6